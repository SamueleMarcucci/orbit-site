{
  "name": "live-orbit-analytics-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create live-orbit-analytics",
    "db:migrate:local": "wrangler d1 execute live-orbit-analytics --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute live-orbit-analytics --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260430.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.15.0"
  }
}
