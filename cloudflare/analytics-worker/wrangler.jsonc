{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-orbit-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "liveorbitapp.com/api/analytics*",
      "zone_name": "liveorbitapp.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "live-orbit-analytics",
      "database_id": "e915fdcf-b653-4b58-89c4-51c66d547ad9"
    }
  ],
  "observability": {
    "enabled": true
  }
}
